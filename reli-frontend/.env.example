# ===========================================
# CONFIGURACIÓN FRONTEND - RELI WebApp
# ===========================================
# Variables para build de producción (Vite)
# En Docker se pasan como --build-arg
# En desarrollo local: cp .env.example .env

# API URL (relativa al proxy nginx en producción)
VITE_API_URL=/api

# Google OAuth2 Client ID
# Obtén en: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=123456789-abcdefghijklmnop.apps.googleusercontent.com

# Supabase (Storage para imágenes)
# URL del proyecto: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://tu-project-ref.supabase.co
# Anon key del dashboard (Settings -> API)
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui
VITE_SUPABASE_BUCKET=images