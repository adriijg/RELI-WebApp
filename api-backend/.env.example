# Copia este archivo como ".env" (misma carpeta, sin ".example") y rellena los valores.
# El ".env" real está ignorado por git: nunca subas claves a GitHub.

# --- Google OAuth2 ---
# Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Base de datos (Supabase pooler) ---
DB_PASSWORD=cambia-esta-password

# --- Admin inicial ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@reli.local
ADMIN_PASSWORD=cambia-esta-password

# --- Federación FFM (scraping) ---
FFM_USER=
FFM_PASS=

# --- Emails con Resend (https://resend.com) ---
# true en local solo si tienes dominio remitente verificado; si no, deja false.
EMAIL_ENABLED=false
# Clave API de Resend (empieza por re_...)
RESEND_API_KEY=
# IMPORTANTE: debe ser un email de un dominio verificado en Resend.
# Formato: "Nombre <correo@dominio-verificado.com>"
# Sin dominio propio verificado, Resend solo deja enviar a tu propio correo de registro.
RESEND_FROM=RELI <no-reply@tudominio.com>
# URL pública del frontend donde está la página /auth (verifica ?verifyEmail= y ?resetPassword=)
FRONTEND_URL=http://localhost:5173/auth
