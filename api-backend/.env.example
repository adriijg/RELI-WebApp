# ===========================================
# CONFIGURACIÓN DE PRODUCCIÓN - RELI WebApp
# ===========================================
# Copia este archivo a .env y rellena los valores reales
# NO commitees el archivo .env real (está en .gitignore)

# --- Admin Bootstrap (solo primera vez) ---
BOOTSTRAP_ADMIN_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=PasswordMuySeguro123!

# --- Base de Datos (Supabase Pooler) ---
DB_PASSWORD=PasswordSupabaseMuySeguro

# --- JWT (OBLIGATORIO en producción: 64+ chars aleatorios) ---
# Genera con: openssl rand -hex 32
JWT_SECRET=tu_jwt_secret_de_64_chars_minimo_aqui

# --- Google OAuth2 (para login con Google) ---
# Obtén en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=123456789-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Gmail SMTP (para emails de verificación/recuperación) ---
EMAIL_ENABLED=true
GMAIL_USER=tu-email@gmail.com
GMAIL_PASSWORD=app_password_de_gmail_no_tu_password_real

# --- FFM (Federación Madrileña) ---
FFM_USER=tu_usuario_ffm
FFM_PASS=tu_password_ffm
# Sync automática lunes y jueves 08:00 (requiere hosting fijo)
FFM_SYNC_ENABLED=true

# --- Frontend URL (para emails de verificación) ---
FRONTEND_URL=https://reallisiados.duckdns.org/auth